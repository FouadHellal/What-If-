# Example nginx reverse proxy. Terminate TLS here and set in .env:
#   PUBLIC_URL=https://whatif.example.com   TRUST_PROXY=true
server {
    listen 443 ssl http2;
    server_name whatif.example.com;

    ssl_certificate     /etc/ssl/certs/whatif.crt;
    ssl_certificate_key /etc/ssl/private/whatif.key;

    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # AI analyses can take a while
    }
}
