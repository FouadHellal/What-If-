# Optional systemd unit to start the stack at boot (Docker's restart policy
# already restarts containers; this only matters if you prefer systemd control).
# Install: sudo cp deploy/what-if.service.example /etc/systemd/system/what-if.service
#          sudo systemctl enable --now what-if
[Unit]
Description=What-If decision planning
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/what-if
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
