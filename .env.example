# What-If configuration. Copy to `.env` and fill in the required values.
# Never commit your real .env file.

# ── Required ────────────────────────────────────────────────────────────────
# Secret used to encrypt stored AI provider keys. Generate with:
#   openssl rand -base64 48
# Keep it safe and stable: changing it makes stored AI keys unreadable.
APP_SECRET=

# Database password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=

# ── Network ─────────────────────────────────────────────────────────────────
# Interface and port the app is published on. 127.0.0.1 keeps it private to the
# VM (use a reverse proxy); 0.0.0.0 exposes it on your network.
WHATIF_BIND=127.0.0.1
WHATIF_PORT=3000

# Public address users open in the browser. When it starts with https://, session
# cookies are marked Secure automatically.
PUBLIC_URL=
# auto | true | false
COOKIE_SECURE=auto
# Set to true when running behind a reverse proxy (Caddy, nginx, Traefik).
TRUST_PROXY=false

# ── Accounts ────────────────────────────────────────────────────────────────
# The first account always becomes the administrator. Afterwards, this default
# can be overridden by the administrator in Settings → Instance.
ALLOW_REGISTRATION=true

# ── Optional instance-wide AI analyst ───────────────────────────────────────
# Leave empty to run without AI (everything except the AI analyst works).
# Users can also configure their own provider in Settings → AI analyst.
# AI_PROVIDER: anthropic | openai | ollama
AI_PROVIDER=
# e.g. https://api.openai.com/v1, http://host.docker.internal:11434 (Ollama)
AI_BASE_URL=
# e.g. claude-sonnet-5-5, or the model name your provider offers
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=50
# Allow users to bring their own provider and key.
AI_ALLOW_USER_CONFIG=true

# ── Optional external data ─────────────────────────────────────────────────
# User-triggered lookups of public reference data (ECB exchange rates via
# api.frankfurter.app, World Bank inflation via api.worldbank.org). Only a
# currency pair or country code is sent. Set to off on air-gapped servers.
EXTERNAL_DATA=on

# ── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
APP_VERSION=2.0.0
POSTGRES_DB=whatif
POSTGRES_USER=whatif
